{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jayfriesen",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Logs + Traces (Cloudflare workers-best-practices)
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 },
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jayfriesen",
			"database_id": "5cdfa910-9fd4-480c-87ac-b848839eb21d",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "jayfriesen-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
