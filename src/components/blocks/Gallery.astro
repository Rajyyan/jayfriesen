---
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type GalleryBlock = Extract<PageContentBlock, { _type: "marketing_gallery" }>;
type Props = BlockComponentProps<GalleryBlock>;

const { value } = Astro.props;
const { anchor_id, headline, images } = value;
const columns = Number(value.columns ?? "3") || 3;
---

<section class="gallery section" id={anchor_id || undefined}>
	<div class="container">
		{headline && (
			<header class="section-header">
				<h2 class="section-headline">{headline}</h2>
			</header>
		)}
		<div class="gallery-grid" style={`--gallery-columns: ${columns}`}>
			{(images ?? []).map((item) =>
				item?.image ? (
					<figure class="gallery-item">
						<Image image={item.image} class="gallery-media" />
						{item.caption && <figcaption>{item.caption}</figcaption>}
					</figure>
				) : null,
			)}
		</div>
	</div>
</section>

<style>
	.gallery {
		padding-top: var(--spacing-2xl);
		padding-bottom: var(--spacing-3xl);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(var(--gallery-columns, 3), minmax(0, 1fr));
		gap: var(--spacing-md);
	}

	.gallery-item {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.gallery-item :global(.gallery-media) {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.gallery-item figcaption {
		padding: var(--spacing-sm) var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.gallery-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
